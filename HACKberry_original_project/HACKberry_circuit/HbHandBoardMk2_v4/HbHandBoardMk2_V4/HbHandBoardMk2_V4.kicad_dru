(version 1)
(rule "class 0:0"
  (condition "A.NetClass == 'default' && B.NetClass == 'Default'")
  (constraint clearance (min 0.1524mm)))

(rule "class 1:1"
  (condition "A.NetClass == 'MCPower' && B.NetClass == 'MCPower'")
  (constraint clearance (min 0.1524mm)))

(rule "class 2:2"
  (condition "A.NetClass == 'Power' && B.NetClass == 'Power'")
  (constraint clearance (min 0.1524mm)))

(rule "class 3:3"
  (condition "A.NetClass == 'GND' && B.NetClass == 'GND'")
  (constraint clearance (min 0.1524mm)))
